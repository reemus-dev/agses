{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Fixtures keep the single-line JSON Claude Code writes
  "ignorePatterns": ["test/fixtures/"],
  "printWidth": 80,
  "bracketSpacing": false,
  "bracketSameLine": true,
  "proseWrap": "always",
  "jsdoc": true,
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "scoped",
        "elementNamePattern": ["@*/**"],
        "selector": "external"
      }
    ],
    "groups": [
      "side_effect",
      "builtin",
      "external",
      "scoped",
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
